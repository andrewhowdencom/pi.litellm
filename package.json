{
  "name": "pi-litellm",
  "version": "0.1.0",
  "description": "Pi extension that adds LiteLLM as a provider with automatic model discovery",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "litellm",
    "llm-proxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewhowdencom/pi.litellm.git"
  },
  "bugs": {
    "url": "https://github.com/andrewhowdencom/pi.litellm/issues"
  },
  "homepage": "https://github.com/andrewhowdencom/pi.litellm#readme",
  "license": "MIT",
  "files": [
    "extensions/",
    "src/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
